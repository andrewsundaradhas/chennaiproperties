# Copy to .env and fill in. Never commit .env.

# --- API ---
NODE_ENV=development
PORT=4000
# Browser origin allowed by CORS (the Vite dev server).
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- AI ---
# AI_PROVIDER: "gemini" or "rules". If unset, Gemini is used when GEMINI_API_KEY is
# present; otherwise the deterministic rule-based interpreter (no network) is used.
AI_PROVIDER=
GEMINI_API_KEY=
# Required when using Gemini. Pick a current model from Google AI Studio's model list
# (deliberately not hard-coded, because model names are retired over time).
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=20000
# low (default) | high | none — Gemini 3.x thinking adds latency; low keeps chat responsive.
GEMINI_THINKING_LEVEL=low
# When Gemini may rephrase the grounded reply: non_english (default) | always | never
GEMINI_COMPOSE=non_english

# --- Database (choose ONE strategy) ---
# Leave DATABASE_URL empty to use the embedded PGlite database (real PostgreSQL in WASM),
# persisted at PGLITE_DATA_DIR. Set DATABASE_URL to use a PostgreSQL / Supabase database.
DATABASE_URL=
PGLITE_DATA_DIR=./data/pgdata
# Supabase: use the *Session pooler* string (IPv4) from Project → Connect, e.g.
#   postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The direct db.<ref>.supabase.co host is IPv6-only and fails on IPv4-only networks.
# TLS: off | require (default for remote hosts) | verify (+ DATABASE_SSL_CA=/path/to/prod-ca-2021.crt)
DATABASE_SSL=
DATABASE_SSL_CA=

# --- Admin auth / sessions ---
# Admin sessions are random tokens stored hashed in the database, so no signing secret is needed.
# Used by `npm run admin:create` when --email is not passed.
ADMIN_BOOTSTRAP_EMAIL=
# Set to "true" only when served over HTTPS (production).
COOKIE_SECURE=false

# --- Future WhatsApp adapter (unused in this phase; see docs/whatsapp-adapter.md) ---
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

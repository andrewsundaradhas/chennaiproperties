{
  "name": "@cp/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../.env src/scripts/seed.ts",
    "db:reset-demo": "tsx --env-file-if-exists=../.env src/scripts/reset-demo.ts",
    "admin:create": "tsx --env-file-if-exists=../.env src/scripts/create-admin.ts",
    "import:csv": "tsx --env-file-if-exists=../.env src/scripts/import-csv.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "telegram:webhook": "tsx --env-file-if-exists=../.env src/scripts/telegram-webhook.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
